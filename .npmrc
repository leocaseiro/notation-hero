# Hard-enforce the package.json `engines.node` floor (>=22.18). Below it, Node's
# native TypeScript type-stripping is off, so `pulumi up` + `nx test infra` fail to
# ESM-load the .ts graph with ERR_UNKNOWN_FILE_EXTENSION. Fail at install, not later.
engine-strict=true

# Supply-chain hardening — clears semgrep npm-missing-minimum-release-age (NH-259). INERT for this repo's
# installs: the package manager is pnpm (see packageManager), which enforces its own minimumReleaseAge (in
# MINUTES = 10080) from pnpm-workspace.yaml, NOT this npm key (npm v11.10+, in DAYS = 7). Kept as
# defense-in-depth if npm is ever run directly here.
min-release-age=7
