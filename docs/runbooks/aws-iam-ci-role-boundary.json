{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LambdaExecLoggingCeiling",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:ap-southeast-2:*:log-group:/aws/lambda/notation-hero-api*"
    }
  ]
}
