\track ("Distortion Guitar" "dist.guit.") {
  color "#EB987D"
  systemsLayout (3 3 3 3 3 3 3 1)
  volume 12
  balance 8
  instrument distortionguitar
}
  \staff {
    score
    tabs
  }
    \tuning (E4 B3 G3 D3 A2 E2) {
      label "Guitar Standard Tuning"
    }
    \clef g2
    \ottava regular
    \simile none
    \ks c
      (5.5 7.4 7.3).8{dy mf instrument distortionguitar beam Up}
