\defaultSystemsLayout 4
\systemsLayout 4
\hideDynamics
\bracketExtendMode nobrackets
\track ("Drumkit" "drm.") {
  color "#75C9E3"
  systemsLayout (3 3 3 3 3 3 3 1)
  volume 12
  balance 8
  instrument percussion
}
  \staff {
    score
  }
    \articulation defaults
    \ts (4 4)
    \tempo 200
    \accidentals auto
    \clef neutral
    \ottava regular
    \simile none
    \ks c
      ("Kick (hit) 2" "Crash high (hit)").4{dy mf beam Down}
      "Hi-Hat (open)".4{beam Down}
      ("Hi-Hat (open)" "Kick (hit) 2").8{beam Down}
      "Kick (hit) 2".8{beam Down}
      "Hi-Hat (open)".4{beam Down}
    |
      ("Kick (hit) 2" "Hi-Hat (open)").4{beam Down}
      "Hi-Hat (open)".4{beam Down}
      ("Hi-Hat (open)" "Kick (hit) 2").8{beam Down}
      "Kick (hit) 2".8{beam Down}
      "Hi-Hat (open)".4{beam Down}
    |
      ("Kick (hit) 2" "Hi-Hat (open)").4{beam Down}
      "Hi-Hat (open)".4{beam Down}
      ("Hi-Hat (open)" "Kick (hit) 2").8{beam Down}
