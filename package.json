{
  "name": "notation-hero",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "lefthook install --reset-hooks-path",
    "build": "pnpm -r --if-present run build",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "test:tooling": "node --test tooling/*.test.mjs",
    "build:deploy": "pnpm --filter @notation-hero/server run build:lambda && pnpm --filter @notation-hero/client run build",
    "pulumi:preview": "pnpm run build:deploy && pnpm --filter @notation-hero/infra run pulumi:preview",
    "pulumi:up": "pnpm run build:deploy && pnpm --filter @notation-hero/infra run pulumi:up",
    "pulumi:destroy": "pnpm --filter @notation-hero/infra run pulumi:destroy",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "depcheck": "depcruise server/src --config .dependency-cruiser.cjs",
    "check:core-purity": "bash tooling/check-core-purity-canary.sh",
    "knip": "knip",
    "syncpack": "syncpack lint",
    "check:layout": "bash tooling/check-layout.sh",
    "check:coverage-ignore": "bash tooling/check-no-coverage-ignore.sh",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:yaml": "yamllint -c .yamllint ."
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@types/node": "^24.0.0",
    "dependency-cruiser": "^17.4.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-regexp": "^3.1.0",
    "eslint-plugin-sonarjs": "^4.1.0",
    "eslint-plugin-unicorn": "^63.0.0",
    "knip": "^6.17.1",
    "lefthook": "^2.1.9",
    "markdownlint-cli2": "^0.22.1",
    "prettier": "^3.8.1",
    "stylelint": "^17.13.0",
    "stylelint-config-standard": "^40.0.0",
    "syncpack": "^15.3.2",
    "typescript": "^5.7.3"
  }
}
