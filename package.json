{
  "name": "notation-hero",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "lefthook install",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "test:tooling": "node --test tooling/*.test.mjs",
    "build": "pnpm -r --if-present run build",
    "depcheck": "depcruise server shared infra --config .dependency-cruiser.cjs",
    "knip": "knip",
    "syncpack": "syncpack lint",
    "check:layout": "bash tooling/check-layout.sh",
    "check:coverage-ignore": "bash tooling/check-no-coverage-ignore.sh",
    "infra:preview": "pnpm --filter @notation-hero/infra pulumi:preview",
    "infra:up": "pnpm --filter @notation-hero/infra pulumi:up",
    "infra:destroy": "pnpm --filter @notation-hero/infra pulumi:destroy"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@types/node": "^24",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "dependency-cruiser": "^16.0.0",
    "eslint": "^9.17.0",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-check-file": "^3.3.1",
    "eslint-plugin-import-x": "^4.16.2",
    "knip": "^6.16.1",
    "lefthook": "2.1.9",
    "syncpack": "^15.3.1",
    "typescript": "^5.7.3"
  }
}
