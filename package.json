{
  "name": "notation-hero",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "lefthook install --reset-hooks-path",
    "build": "pnpm -r --if-present run build",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "test:tooling": "node --test tooling/*.test.mjs",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "depcheck": "depcruise server/src --config .dependency-cruiser.cjs",
    "check:core-purity": "bash tooling/check-core-purity-canary.sh",
    "knip": "knip",
    "syncpack": "syncpack lint",
    "check:layout": "bash tooling/check-layout.sh",
    "check:coverage-ignore": "bash tooling/check-no-coverage-ignore.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@types/node": "^24.0.0",
    "dependency-cruiser": "^17.4.3",
    "knip": "^6.17.1",
    "lefthook": "^2.1.9",
    "prettier": "^3.8.1",
    "syncpack": "^15.3.2",
    "typescript": "^5.7.3"
  }
}
