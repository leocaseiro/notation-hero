{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "isolatedDeclarations": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": "."
  },
  "include": ["**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
